    "date_of_birth:widen_band": {
      "column": "date_of_birth",
      "op": "widen_band",
      "width": 20,
      "reason": "At-risk rows only: age band widened to 20 years."
    },
    "municipality:set": {
      "column": "municipality",
      "op": "set",
      "value": "other",
      "reason": "At-risk rows only: place becomes other."
    },
    "arrival_ts:widen_hour": {
      "column": "arrival_ts",
      "op": "widen_hour",
      "block": 3,
      "reason": "At-risk rows only: hour widened to a 3-hour block."
    },
    "arrival_ts:widen_hour_8": {
      "column": "arrival_ts",
      "op": "widen_hour",
      "block": 8,
      "reason": "At-risk rows only: hour widened to an 8-hour block (night, day, evening)."
    }
  },
  "floor": 0.85,
