      "op": "set",
      "value": "other",
      "reason": "At-risk rows only: municipality becomes other."
    },
    "hour3": {
      "column": "arrival_ts",
      "op": "widen_hour",
      "block": 3,
      "reason": "At-risk rows only: arrival hour widened to a 3-hour block."
    }
  },
