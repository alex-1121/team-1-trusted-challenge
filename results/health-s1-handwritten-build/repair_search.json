{
  "target": {
    "table": "ed_visits",
    "k": 5,
    "l": 2,
    "sensitive": "icd10_primary",
    "columns": [
      "date_of_birth",
      "sex",
      "municipality",
      "arrival_ts"
    ],
    "linked": {
      "date_of_birth": [
        "age"
      ]
    },
    "reason": "Every released ed_visits row shares its age band, sex, municipality and arrival hour with at least 4 other rows (k of at least 5, the HEALTH-S1 target), and every such group holds at least 2 distinct primary diagnoses (l of at least 2), so knowing those four facts never singles out a visit or reveals its diagnosis. Only the rows that miss the target are coarsened."
  },
  "ladder": {
    "age20": {
      "column": "date_of_birth",
      "op": "widen_band",
      "width": 20,
      "reason": "At-risk rows only: 10-year age band widened to 20 years (also in age)."
    },
    "town_other": {
      "column": "municipality",
      "op": "set",
      "value": "other",
      "reason": "At-risk rows only: municipality becomes other."
    },
    "hour3": {
      "column": "arrival_ts",
      "op": "widen_hour",
      "block": 3,
      "reason": "At-risk rows only: arrival hour widened to a 3-hour block."
    }
  },
