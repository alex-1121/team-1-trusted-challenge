{
  "target": {
    "table": "ed_visits",
    "join_flags": [
      {
        "table": "lab_results",
        "on": "visit_id"
      }
    ],
    "k": 5,
    "l": 2,
    "sensitive": "icd10_primary",
    "columns": [
      "date_of_birth",
      "municipality",
      "arrival_ts"
    ],
    "linked": {
      "date_of_birth": [
        "age"
      ]
    },
    "reason": "Every released ed_visits row shares its kept quasi-identifiers (date_of_birth, municipality, arrival_ts) with at least 4 other rows, and every such group holds at least 2 distinct icd10_primary values; only the rows that miss the target are coarsened, and rows still at risk get those columns suppressed."
  },
  "ladder": {
    "date_of_birth:widen_band": {
      "column": "date_of_birth",
      "op": "widen_band",
      "width": 20,
      "reason": "At-risk rows only: age band widened to 20 years."
    },
    "municipality:set": {
      "column": "municipality",
      "op": "set",
      "value": "other",
      "reason": "At-risk rows only: place becomes other."
    },
    "arrival_ts:widen_hour": {
      "column": "arrival_ts",
      "op": "widen_hour",
      "block": 3,
      "reason": "At-risk rows only: hour widened to a 3-hour block."
    }
  },
  "floor": 0.85,
  "rule": "best composite among orders with no row at risk and every required task at or above the floor",
